// Windows file details of @RC_FILE@ (Properties → Details, Task Manager, the installer): product, version
// and publisher. CMake fills it from project(Flowen VERSION …); FlowenInnoSetup.iss reads the version here.
#pragma code_page(65001)
#include <winver.h>
@RC_ICON@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "Attribute Overload"
            VALUE "FileDescription", "@RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@RC_FILE@"
            VALUE "LegalCopyright", "© 2026 Attribute Overload"
            VALUE "OriginalFilename", "@RC_FILE@"
            VALUE "ProductName", "Flowen"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
