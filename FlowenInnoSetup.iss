; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
;
; Instalador de Flowen para Inno Setup 7 (también compila con Inno Setup 6.5 o posterior).
; Convierte dist\Flowen-x64 (lo arma packaging\windows.ps1) en dist\Flowen-<versión>-Setup-x64.exe.
; Lo compila packaging\instalador.ps1, o el IDE de Inno Setup abriendo este archivo.
; La versión se lee de flowen.exe, que la toma de project(Flowen VERSION …) en CMakeLists.txt.

#define AppName "Flowen"
#define AppExe "flowen.exe"
; DistDir: la carpeta armada por packaging\windows.ps1 (packaging\instalador.ps1 -Dist indica otra).
#ifndef DistDir
  #define DistDir AddBackslash(SourcePath) + "dist\Flowen-x64"
#endif
#define Repo "https://github.com/robertocharretonkaplun/Flowen"
#ifndef AppVersion
  #define AppVersion GetStringFileInfo(AddBackslash(DistDir) + AppExe, "ProductVersion")
#endif
#if AppVersion == ""
  #error Falta flowen.exe con su versión en DistDir: compila Flowen y ejecuta packaging\windows.ps1 antes.
#endif

[Setup]
; Fijo para siempre: Windows reconoce con él las actualizaciones y la desinstalación de Flowen.
AppId={{1A857ED7-AD59-4810-BD40-6E3C48D42C01}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=Attribute Overload
AppPublisherURL=https://www.attributeoverload.com
AppSupportURL={#Repo}/issues
AppUpdatesURL={#Repo}/releases
AppCopyright=© 2026 Attribute Overload
VersionInfoVersion={#AppVersion}
VersionInfoProductName={#AppName}
VersionInfoDescription=Instalador de {#AppName}
; Para el usuario actual, sin permisos de administrador (%LOCALAPPDATA%\Programs\Flowen);
; el asistente ofrece instalarlo para todos. Una ruta fija mantiene válidos los conectores MCP.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
DefaultDirName={autopf}\{#AppName}
UsePreviousAppDir=yes
DisableProgramGroupPage=yes
DefaultGroupName={#AppName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; Windows 10 1809 o posterior, como pide Qt 6.8.
MinVersion=10.0.17763
OutputDir=dist
OutputBaseFilename={#AppName}-{#AppVersion}-Setup-x64
SetupIconFile=assets\flowen.ico
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
Compression=lzma2/max
SolidCompression=yes
; Claro u oscuro según Windows, con la identidad de Flowen en los dos.
WizardStyle=modern dynamic
WizardImageFile=assets\instalador\panel-claro-100.png,assets\instalador\panel-claro-150.png,assets\instalador\panel-claro-200.png,assets\instalador\panel-claro-250.png
WizardImageFileDynamicDark=assets\instalador\panel-oscuro-100.png,assets\instalador\panel-oscuro-150.png,assets\instalador\panel-oscuro-200.png,assets\instalador\panel-oscuro-250.png
WizardSmallImageFile=assets\instalador\icono-100.png,assets\instalador\icono-150.png,assets\instalador\icono-200.png,assets\instalador\icono-250.png
WizardSmallImageFileDynamicDark=assets\instalador\icono-100.png,assets\instalador\icono-150.png,assets\instalador\icono-200.png,assets\instalador\icono-250.png
; Cierra Flowen y su servidor MCP si están abiertos, para poder reemplazar sus archivos.
CloseApplications=yes
RestartApplications=no
ShowLanguageDialog=auto

[Languages]
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[CustomMessages]
spanish.AppComment=Notas, páginas y tareas
english.AppComment=Notes, pages and tasks

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#DistDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"; Comment: "{cm:AppComment}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Comment: "{cm:AppComment}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

; Desinstalar quita el programa, no tus notas: la biblioteca sigue en %LOCALAPPDATA%\Flowen.
