# Documentación de Flowen con Doxygen (1.9.5 o posterior).
# Desde la raíz del repositorio:  doxygen docs/Doxyfile   →   build-docs/html/index.html
# GitHub Actions la publica en GitHub Pages (.github/workflows/docs.yml).
# Solo se indican los valores que cambian; el resto queda como Doxygen lo trae.

PROJECT_NAME           = Flowen
PROJECT_NUMBER         = $(FLOWEN_VERSION)
PROJECT_BRIEF          = "Editor local de páginas para Windows, con IA y MCP · Attribute Overload"
PROJECT_LOGO           = assets/flowen-64.png
OUTPUT_DIRECTORY       = build-docs
OUTPUT_LANGUAGE        = Spanish
INPUT_ENCODING         = UTF-8

# La portada es docs/INICIO.md; siguen la guía de uso, la arquitectura, el desarrollo y el código de src/.
# (El README es la portada del repositorio en GitHub y usa HTML que Doxygen no necesita.)
INPUT                  = docs/INICIO.md docs/GUIA.md docs/ARQUITECTURA.md docs/DESARROLLO.md src
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/INICIO.md
IMAGE_PATH             = docs/capturas docs/marca
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3

# Todo el código aparece, aunque una función no tenga comentario (///) propio.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
EXTRACT_PRIVATE        = NO
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
SORT_MEMBER_DOCS       = NO

# Macros de Qt que no aportan nada a la documentación.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = Q_INVOKABLE= Q_ENUM(x)= Q_OBJECT= "FLOWEN_VERSION=\"0\""

# HTML con índice lateral, modo claro u oscuro a elección y los colores de Flowen.
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = TOGGLE
HTML_EXTRA_STYLESHEET  = docs/doxygen/flowen.css
HTML_TIMESTAMP         = NO
SEARCHENGINE           = YES

# Diagramas de clases e inclusiones con Graphviz, si está instalado.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
